<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_today_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/widget_bg_dark">
    <TextView
        android:id="@+id/widget_today_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#B3FFFFFF"
        android:textSize="12sp"
        android:text="Today" />
    <TextView
        android:id="@+id/widget_today_next_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#FFF6D365"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        android:text="UP NEXT" />
    <TextView
        android:id="@+id/widget_today_next"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:maxLines="2"
        android:ellipsize="end"
        android:text="Nothing scheduled" />
    <LinearLayout
        android:id="@+id/widget_today_devotional"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="10dp"
        android:background="@drawable/widget_pill">
        <TextView
            android:id="@+id/widget_today_devotional_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="Today's devotional" />
        <TextView
            android:id="@+id/widget_today_listen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:background="@drawable/widget_button"
            android:textColor="#FF1B1530"
            android:textSize="12sp"
            android:textStyle="bold"
            android:text="Open" />
    </LinearLayout>
</LinearLayout>
