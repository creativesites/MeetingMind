    <string name="paywall_price_per_period">%1$s / %2$s</string>
    <string name="paywall_best_value">Best value</string>
    <string name="paywall_col_free">Free</string>
    <string name="paywall_col_plan">Plan</string>
    <string name="paywall_included">Included</string>
