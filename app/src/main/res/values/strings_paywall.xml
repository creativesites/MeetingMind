<!--
  The plans page (feature/paywall/PaywallScreen.kt). Prices, periods and trial lengths always come from the store
  and are passed in as arguments; never write a price here.
-->
<resources>
    <!-- Under the headline: the free app stays free. -->
    <string name="paywall_free_stays_free">You can keep using MeetingMind free. This just adds more.</string>
    <string name="paywall_choose_plan">Choose your plan</string>
    <string name="paywall_show_fewer">Show fewer plans</string>
    <string name="paywall_view_all">View all plans (including BYOK and Church)</string>
    <string name="paywall_what_next">What happens next</string>
