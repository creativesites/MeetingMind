    <string name="paywall_billed_every">Billed every %1$s</string>
    <string name="paywall_one_payment">One payment, never renews</string>
    <!-- %1$d: the store's free-trial length in days. -->
    <string name="paywall_trial_days">%1$d-day free trial</string>
