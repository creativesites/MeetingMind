    <!-- %1$s: the plan's name, e.g. "Pro". -->
    <string name="paywall_current_plan">You\'re on %1$s</string>
    <string name="paywall_no_commitment">No commitment. Cancel any time in Google Play.</string>
    <string name="paywall_change_any_time">Change or cancel any time in Google Play.</string>
