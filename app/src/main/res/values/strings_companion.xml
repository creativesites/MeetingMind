<?xml version="1.0" encoding="utf-8"?>
<!--
  Companion (Zuri and friends) copy. Source: docs/mvp/ZURI_EXPERIENCE.md sections 5 and 6.

  Placeholders: positional only (%1$s, %2$s). Each string that has one documents its args in the comment above it.
  {companion} = the companion's name, as the user chose it (default "Zuri").
  {name}      = the user's name.
  Apostrophes and double quotes are escaped with a backslash, as Android resources require.

  Variants: a <string-array> lists the variants of one moment in a fixed order. For the processing captions the order
  is Everyday, Faith, Work, Study. Where the spec has no variant for a space ("—"), the Everyday line is used.
-->
<resources>

    <!-- Form display names (spec 1.2). -->
    <string name="form_zuri">Zuri</string>
    <string name="form_nas">Nas</string>
    <string name="form_wren">Wren</string>
    <string name="form_page">Page</string>

