<?xml version="1.0" encoding="utf-8"?>
<!--
  MeetingMind is local-first and privacy-first: recordings, transcripts, and AI-generated content
  never leave the device except when the user explicitly shares or exports them (see
  docs/DATA_SAFETY.md). Excluding them here keeps that promise consistent even with Android's
  otherwise-automatic cloud backup / device-transfer — a user's recordings should not silently end
  up in their Google Drive Auto Backup or a new device's transfer without them choosing to.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="meetings/" />
        <exclude domain="file" path="read_to_me/" />
        <exclude domain="database" path="meetmind_database" />
        <exclude domain="file" path="datastore/meetmind_credentials.preferences_pb" />
        <exclude domain="sharedpref" path="meetmind_credentials" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="meetings/" />
        <exclude domain="file" path="read_to_me/" />
        <exclude domain="database" path="meetmind_database" />
        <exclude domain="file" path="datastore/meetmind_credentials.preferences_pb" />
        <exclude domain="sharedpref" path="meetmind_credentials" />
    </device-transfer>
</data-extraction-rules>
