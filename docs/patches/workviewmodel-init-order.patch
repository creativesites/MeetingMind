@@ -0,0 +1,26 @@
+package com.craftflowtechnologies.meetingmind.feature.work
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.io.File
+
+/**
+ * Kotlin builds a class's properties in the order they're written, and `init` blocks run in that
+ * same order. A start-up coroutine in an early `init` can therefore run before a property declared
+ * further down exists, and read it as null. That crashed a real phone right after unlock. The
+ * rule: in WorkViewModel the `init` block comes after every property.
+ */
+class WorkViewModelInitOrderTest {
+    @Test
+    fun `the init block comes after every property`() {
+        val file = File("src/main/java/com/craftflowtechnologies/meetingmind/feature/work/WorkViewModel.kt")
+        assertTrue("source not found from ${File(".").absolutePath}", file.isFile)
+        val lines = file.readLines()
+        val init = lines.indexOfFirst { it.startsWith("    init {") }
+        assertTrue("WorkViewModel has no init block", init >= 0)
+        val property = Regex("""^    (private |internal )?(val|var|lateinit var) \w+""")
+        val after = lines.drop(init + 1).mapIndexedNotNull { i, l -> if (property.containsMatchIn(l)) "line ${init + 2 + i}: ${l.trim()}" else null }
+        assertEquals("properties declared after init:\n" + after.joinToString("\n"), emptyList<String>(), after)
+    }
+}
