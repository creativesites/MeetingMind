rules_version = '2';

// Circles v2 (docs/mvp/FAITH_V2.md section 2.4). Anything privileged (create circle, join, roles, posts,
// approval, counters, invites, anonymous authorship) goes through the Cloudflare Worker in
// server/circles-api, whose service account bypasses these rules. Clients only get:
//   - read access for circle members
//   - their own comments / reactions
//   - their own chat messages, message reactions, poll votes and prayer-chain slot claims
//   - their own profile
// Default deny.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function memberDoc(circleId) {
      return /databases/$(database)/documents/circles/$(circleId)/members/$(request.auth.uid);
    }
    function isMember(circleId) { return signedIn() && exists(memberDoc(circleId)); }
    function isAdmin(circleId) {
      return isMember(circleId) && get(memberDoc(circleId)).data.role in ['owner', 'admin'];
    }
    function postPath(circleId, postId) {
      return /databases/$(database)/documents/circles/$(circleId)/posts/$(postId);
    }
    function liveOpenPost(circleId, postId) {
      return exists(postPath(circleId, postId)) && get(postPath(circleId, postId)).data.deleted == false;
    }

    function pollDoc(circleId, pollId) {
      return get(/databases/$(database)/documents/circles/$(circleId)/polls/$(pollId)).data;
    }
    function pollIsOpen(circleId, pollId) {
      return exists(/databases/$(database)/documents/circles/$(circleId)/polls/$(pollId))
        && pollDoc(circleId, pollId).closed == false;
    }
    function validCard(c) {
      return c is map
        && c.keys().hasOnly(['templateId', 'text', 'mood', 'verseRef', 'verseText'])
        && c.keys().hasAll(['templateId', 'text'])
        && c.templateId is string && c.templateId.size() > 0 && c.templateId.size() <= 40
        && c.text is string && c.text.size() > 0 && c.text.size() <= 600
        && (!('mood' in c) || (c.mood is string && c.mood.size() <= 24))
        && (!('verseRef' in c) || (c.verseRef is string && c.verseRef.size() <= 64))
        && (!('verseText' in c) || (c.verseText is string && c.verseText.size() <= 600));
    }

    match /circles/{circleId} {
      // No listing/enumeration: clients must know the circle id AND be a member.
      allow get: if isMember(circleId);
      allow list, create, update, delete: if false;

      // Member directory (role, displayName, joinedAt, muted). Written only by the Worker.
      match /members/{uid} {
        allow get: if isMember(circleId);
        allow list: if isMember(circleId);
        allow write: if false;
      }

      match /posts/{postId} {
        allow get, list: if isMember(circleId);
        allow write: if false;

        match /comments/{commentId} {
          allow get, list: if isMember(circleId);
          allow create: if isMember(circleId)
            && liveOpenPost(circleId, postId)
            && request.resource.data.keys().hasOnly(['authorUid', 'displayName', 'body', 'parentId', 'createdAt'])
            && request.resource.data.keys().hasAll(['authorUid', 'body', 'createdAt'])
            && request.resource.data.authorUid == request.auth.uid
            && request.resource.data.body is string
            && request.resource.data.body.size() > 0
            && request.resource.data.body.size() <= 2000
            && request.resource.data.createdAt == request.time
            && (!('displayName' in request.resource.data)
                || (request.resource.data.displayName is string && request.resource.data.displayName.size() <= 40))
            && (!('parentId' in request.resource.data)
                || request.resource.data.parentId == null
                || (request.resource.data.parentId is string
                    && exists(/databases/$(database)/documents/circles/$(circleId)/posts/$(postId)/comments/$(request.resource.data.parentId))
                    && get(/databases/$(database)/documents/circles/$(circleId)/posts/$(postId)/comments/$(request.resource.data.parentId)).data.get('parentId', null) == null));
          // Edit own comment's text only; authorship and time are immutable.
          allow update: if isMember(circleId)
            && resource.data.authorUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['body'])
            && request.resource.data.body is string
            && request.resource.data.body.size() > 0
            && request.resource.data.body.size() <= 2000;
          allow delete: if isMember(circleId)
            && (resource.data.authorUid == request.auth.uid || isAdmin(circleId));
        }

        // One reaction per user, doc id == uid. (The Worker's syncCounts keeps counters honest.)
        match /reactions/{uid} {
          allow get: if isMember(circleId) && uid == request.auth.uid;
          allow list: if false;
          allow create: if isMember(circleId)
            && uid == request.auth.uid
            && liveOpenPost(circleId, postId)
            && request.resource.data.keys().hasOnly(['authorUid', 'kind', 'createdAt'])
            && request.resource.data.authorUid == request.auth.uid
            && request.resource.data.kind in ['praying', 'amen', 'heart', 'celebrate']
            && request.resource.data.createdAt == request.time;
          allow update: if isMember(circleId)
            && uid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['kind'])
            && request.resource.data.kind in ['praying', 'amen', 'heart', 'celebrate'];
          allow delete: if isMember(circleId) && uid == request.auth.uid;
        }

        // "I prayed" markers: a member can see only their own, never who else prayed.
        match /prayers/{uid} {
          allow get: if isMember(circleId) && uid == request.auth.uid;
          allow list, write: if false;
        }

        match /updates/{updateId} {
          allow get, list: if isMember(circleId);
          allow write: if false;
        }
      }

      // ---- Chat and fun (FAITH_V2 section 2.2b) ----
      // Clients write kinds text|card|reply as themselves. poll|celebration|chain messages come from
      // the Worker (createPoll / celebrate / startChain). Hard deletes are denied: soft-delete only.
      match /messages/{msgId} {
        allow get, list: if isMember(circleId);

        allow create: if isMember(circleId)
          && request.resource.data.keys().hasOnly(['authorUid', 'displayName', 'kind', 'text', 'replyTo', 'card', 'createdAt', 'deleted'])
          && request.resource.data.keys().hasAll(['authorUid', 'kind', 'text', 'createdAt', 'deleted'])
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.deleted == false
          && request.resource.data.createdAt == request.time
          && request.resource.data.kind in ['text', 'card', 'reply']
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 2000
          && (!('displayName' in request.resource.data)
              || (request.resource.data.displayName is string && request.resource.data.displayName.size() <= 40))
          && (request.resource.data.kind == 'card'
              ? (request.resource.data.keys().hasAll(['card']) && validCard(request.resource.data.card) && !('replyTo' in request.resource.data))
              : (request.resource.data.text.size() > 0 && !('card' in request.resource.data)))
          && (request.resource.data.kind == 'reply'
              ? (request.resource.data.replyTo is string
                 && request.resource.data.replyTo.size() > 0 && request.resource.data.replyTo.size() <= 40
                 && exists(/databases/$(database)/documents/circles/$(circleId)/messages/$(request.resource.data.replyTo)))
              : !('replyTo' in request.resource.data));

        // Edit own text (not cards or Worker-made kinds); time of edit is the server time.
        allow update: if isMember(circleId)
          && resource.data.authorUid == request.auth.uid
          && resource.data.kind in ['text', 'reply']
          && resource.data.deleted == false
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.editedAt == request.time;

        // Soft-delete: own message, or any message for admins. Content is blanked.
        allow update: if isMember(circleId)
          && (resource.data.authorUid == request.auth.uid || isAdmin(circleId))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted', 'text', 'card'])
          && request.resource.data.deleted == true
          && request.resource.data.text == ''
          && request.resource.data.get('card', null) == null;

        allow delete: if false;

        // One emoji reaction per member per message, doc id == uid. Chat reactions are not anonymous.
        match /reactions/{uid} {
          allow get, list: if isMember(circleId);
          allow create: if isMember(circleId)
            && uid == request.auth.uid
            && get(/databases/$(database)/documents/circles/$(circleId)/messages/$(msgId)).data.deleted == false
            && request.resource.data.keys().hasOnly(['authorUid', 'emoji', 'createdAt'])
            && request.resource.data.authorUid == request.auth.uid
            && request.resource.data.emoji in ['🙏', '❤️', '😂', '🎉', '👍', '🔥']
            && request.resource.data.createdAt == request.time;
          allow update: if isMember(circleId)
            && uid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['emoji'])
            && request.resource.data.emoji in ['🙏', '❤️', '😂', '🎉', '👍', '🔥'];
          allow delete: if isMember(circleId) && uid == request.auth.uid;
        }
      }

      // Polls are created and closed by the Worker. Votes: one doc per member (id == uid), open polls only.
      match /polls/{pollId} {
        allow get, list: if isMember(circleId);
        allow write: if false;

        match /votes/{uid} {
          allow get, list: if isMember(circleId);
          allow create, update: if isMember(circleId)
            && uid == request.auth.uid
            && pollIsOpen(circleId, pollId)
            && request.resource.data.keys().hasOnly(['authorUid', 'choices', 'updatedAt'])
            && request.resource.data.keys().hasAll(['authorUid', 'choices', 'updatedAt'])
            && request.resource.data.authorUid == request.auth.uid
            && request.resource.data.updatedAt == request.time
            && request.resource.data.choices is list
            && request.resource.data.choices.size() >= 1
            && request.resource.data.choices.toSet().size() == request.resource.data.choices.size()
            && request.resource.data.choices.hasOnly(pollDoc(circleId, pollId).optionIds)
            && request.resource.data.choices.size() <= (pollDoc(circleId, pollId).multi == true ? 6 : 1);
          allow delete: if isMember(circleId) && uid == request.auth.uid && pollIsOpen(circleId, pollId);
        }
      }

      // 24-hour prayer chains are started by the Worker; members claim an hour (slot id "0".."23").
      match /chains/{chainId} {
        allow get, list: if isMember(circleId);
        allow write: if false;

        match /slots/{hour} {
          allow get, list: if isMember(circleId);
          allow create: if isMember(circleId)
            && hour.matches('^([0-9]|1[0-9]|2[0-3])$')
            && get(/databases/$(database)/documents/circles/$(circleId)/chains/$(chainId)).data.endsAt > request.time
            && request.resource.data.keys().hasOnly(['authorUid', 'displayName', 'createdAt'])
            && request.resource.data.keys().hasAll(['authorUid', 'createdAt'])
            && request.resource.data.authorUid == request.auth.uid
            && request.resource.data.createdAt == request.time
            && (!('displayName' in request.resource.data)
                || (request.resource.data.displayName is string && request.resource.data.displayName.size() <= 40));
          // Slots are claim-once: no update. Release only your own (admins can clear any).
          allow update: if false;
          allow delete: if isMember(circleId) && (resource.data.authorUid == request.auth.uid || isAdmin(circleId));
        }
      }

      // Prayer requests awaiting approval. Admins only; the doc carries no author information.
      match /pending/{postId} {
        allow get, list: if isAdmin(circleId);
        allow write: if false;
      }

      // Real authorship of every post (anonymity!). Never client-readable or writable.
      match /postAuthors/{postId} {
        allow read, write: if false;
      }

      // Reports (reporter stored only as a keyed hash in the id).
      match /reports/{reportId} {
        allow get, list: if isAdmin(circleId);
        allow write: if false;
      }
    }

    // Profile: readable and editable by its owner only. fcmTokens and anything else is Worker-only.
    match /users/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if false;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['displayName', 'photoUrl'])
        && validProfile(request.resource.data);
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoUrl'])
        && validProfile(request.resource.data);
      allow delete: if false;
    }
    function validProfile(d) {
      return (!('displayName' in d) || (d.displayName is string && d.displayName.size() <= 40))
          && (!('photoUrl' in d) || d.photoUrl == null || (d.photoUrl is string && d.photoUrl.size() <= 500));
    }

    // invites, userMeta, prayerTally, reports etc. are Worker-only via the catch-all.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
